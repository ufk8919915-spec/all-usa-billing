NODE_ENV=production
PORT=3443
APP_ENCRYPTION_KEY=<32+ byte random secret from KMS/HSM>
AUDIT_HMAC_KEY=<32+ byte random secret from KMS/HSM>
SESSION_SECRET=<32+ byte random secret from KMS/HSM>
COOKIE_SECURE=true
TLS_CERT=/absolute/path/fullchain.pem
TLS_KEY=/absolute/path/private.key
# PostgreSQL/RLS deployment should use schema.sql and set app.clinic_id per authenticated transaction.
